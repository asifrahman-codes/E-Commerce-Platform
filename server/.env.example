```dotenv
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=replace_with_another_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep only if your existing payment gateway uses these variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info

NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
```